{
  "name": "ide-beta",
  "version": "1.0.0-beta.7",
  "description": "Desktop dashboard for Arduino Uno",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable",
    "dist:win": "electron-builder --win portable --x64",
    "dist:linux": "electron-builder --linux AppImage tar.gz --x64",
    "check:ui": "electron scripts/smoke.cjs"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.unobench.app",
    "productName": "IDE-beta",
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "workspace.js",
      "icon.png",
      "fonts/**/*"
    ],
    "win": {
      "target": "portable",
      "icon": "icon.ico"
    },
    "portable": {
      "artifactName": "IDE-beta.exe"
    },
    "linux": {
      "target": ["AppImage", "tar.gz"],
      "category": "Development",
      "icon": "icon.png",
      "executableName": "ide-beta",
      "artifactName": "IDE-beta-linux-${arch}.${ext}"
    }
  },
  "author": "IDE-beta",
  "allowScripts": {
    "electron@33.4.11": true
  }
}
