{
  "name": "ide-beta",
  "version": "1.0.0-beta.4",
  "description": "Desktop dashboard for Arduino Uno",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.unobench.app",
    "productName": "IDE-beta",
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "icon.png",
      "fonts/**/*"
    ],
    "win": {
      "target": "portable",
      "icon": "icon.ico"
    },
    "portable": {
      "artifactName": "IDE-beta.exe"
    }
  },
  "author": "IDE-beta",
  "allowScripts": {
    "electron@33.4.11": true
  }
}
